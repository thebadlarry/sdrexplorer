{
  "_comment": [
    "What install.sh installs. The core's own system packages and optional builds are here; each module's",
    "are in its repo's module.json (same 'apt' / 'ext' / 'venvs' fields), so this file names no module's",
    "dependencies. Package names are Debian 12 / Ubuntu 24.04's. 'repo_base' is where the module repos live."
  ],
  "format": 1,
  "repo_base": "https://github.com/thebadlarry",
  "ref": "main",
  "apt": {
    "required": ["git", "python3", "python3-venv", "gnuradio", "gr-osmosdr", "python3-pyqt5", "python3-numpy",
                 "python3-scipy", "hackrf", "rtl-sdr"],
    "recommended": ["python3-pyqt5.qtwebengine", "soapysdr-tools", "python3-zeep"],
    "build": ["build-essential", "cmake", "pkg-config", "gnuradio-dev", "pybind11-dev", "python3-dev"]
  },
  "ext": [
    {
      "key": "gr_osmosdr",
      "name": "gr-osmosdr",
      "for": "SDR devices; patched so releasing PTT on a HackRF can't hang (else the system's gr-osmosdr is used)",
      "repo": "https://gitea.osmocom.org/sdr/gr-osmosdr.git",
      "commit": "73d8982",
      "patches": ["patches/gr-osmosdr-hackrf-sink-stop.patch"],
      "build": {"system": "cmake", "args": ["-DCMAKE_BUILD_TYPE=Release", "-DENABLE_DOXYGEN=OFF"]},
      "apt": ["libhackrf-dev", "librtlsdr-dev", "libuhd-dev", "libmirisdr-dev", "libairspy-dev",
              "libairspyhf-dev", "libsoapysdr-dev", "libfreesrp-dev", "libxtrx-dev", "libbladerf-dev"],
      "optional": true,
      "feature": "osmosdr"
    },
    {
      "key": "gr_rds",
      "name": "gr-rds",
      "for": "RDS station names on WFM broadcast",
      "repo": "https://github.com/bastibl/gr-rds.git",
      "commit": "58facb6",
      "patches": ["patches/gr-rds-include-thread.patch"],
      "build": {"system": "cmake", "args": ["-DCMAKE_BUILD_TYPE=Release"]},
      "apt": ["libboost-locale-dev"],
      "feature": "rds"
    },
    {
      "key": "gr_adsb",
      "name": "gr-adsb",
      "for": "ADS-B (1090 MHz) aircraft",
      "repo": "https://github.com/mhostetter/gr-adsb.git",
      "commit": "b1b5b13",
      "build": {"system": "none"},
      "paths": {"gr_adsb": "{src}/python"},
      "feature": "adsb"
    }
  ],
  "modules": [
    {"name": "paging", "repo": "sdrexplorer-paging", "default": true},
    {"name": "digital", "repo": "sdrexplorer-digital", "default": true},
    {"name": "classifier", "repo": "sdrexplorer-classifier", "default": true},
    {"name": "train", "repo": "sdrexplorer-train", "default": false}
  ],
  "models": {"repo": "sdrexplorer-models", "for": "classifier",
             "_comment": "the classifier's trained models: manifest in the repo, files in its GitHub release"}
}
